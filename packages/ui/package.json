{
    "name": "@rax/ui",
    "version": "0.0.0",
    "description": "React component library for the Rax design system",
    "type": "module",
    "license": "MIT",
    "scripts": {
        "typecheck": "tsc --noEmit",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build",
        "build": "vite build --config vite.lib.config.ts"
    },
    "sideEffects": [
        "**/*.css"
    ],
    "files": [
        "dist",
        "src/styles"
    ],
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./styles.css": "./src/styles/index.css"
    },
    "peerDependencies": {
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "tailwindcss": "^4.0.0"
    },
    "dependencies": {
        "@rax/tokens": "workspace:*",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "radix-ui": "^1.8.1",
        "tailwind-merge": "^3.7.0"
    },
    "devDependencies": {
        "@storybook/addon-a11y": "^10.6.7",
        "@storybook/addon-docs": "^10.6.7",
        "@storybook/addon-themes": "^10.6.7",
        "@storybook/react-vite": "^10.6.7",
        "@swc/core": "^1.16.22",
        "@swc/jest": "^0.2.39",
        "@tailwindcss/vite": "^4.3.5",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.9",
        "@types/jest": "^30.0.0",
        "@types/jest-axe": "^3.5.9",
        "@types/node": "^26.6.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.3.0",
        "jest": "^30.5.2",
        "jest-axe": "^11.0.0",
        "jest-environment-jsdom": "^30.5.2",
        "lucide-react": "^1.72.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "storybook": "^10.6.7",
        "tailwindcss": "^4.3.5",
        "vite": "^8.3.8",
        "vite-plugin-dts": "^5.1.2"
    },
    "publishConfig": {
        "access": "public"
    }
}
