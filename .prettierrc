{
    "$schema": "https://json.schemastore.org/prettierrc",
    "printWidth": 120,
    "tabWidth": 4,
    "useTabs": false,
    "singleQuote": true,
    "arrowParens": "avoid",
    "trailingComma": "all",
    "endOfLine": "lf",
    "plugins": ["@ianvs/prettier-plugin-sort-imports", "prettier-plugin-tailwindcss"],
    "tailwindStylesheet": "./packages/ui/.storybook/storybook.css",
    "importOrder": [
        "<BUILTIN_MODULES>",
        "",
        "<TYPES>^react$",
        "^react$",
        "^react-dom(.*)$",
        "",
        "<TYPES>",
        "<THIRD_PARTY_MODULES>",
        "",
        "<TYPES>^@rax/",
        "^@rax/(.*)$",
        "",
        "<TYPES>^@/",
        "^@/lib/(.*)$",
        "^@/hooks/(.*)$",
        "^@/components/(.*)$",
        "",
        "<TYPES>^[.]",
        "^[.]",
        "",
        "\\.css$"
    ],
    "importOrderTypeScriptVersion": "5.0.0",
    "overrides": [
        {
            "files": ["*.yaml", "*.yml"],
            "options": { "tabWidth": 2 }
        }
    ]
}
