{
    "$schema": "https://json.schemastore.org/prettierrc",
    "printWidth": 120,
    "tabWidth": 4,
    "singleQuote": true,
    "arrowParens": "avoid",
    "trailingComma": "all",
    "endOfLine": "lf",
    "plugins": ["@ianvs/prettier-plugin-sort-imports", "prettier-plugin-tailwindcss"],
    "importOrder": [
        "<BUILTIN_MODULES>",
        "",
        "^react$",
        "^react-dom(.*)$",
        "<THIRD_PARTY_MODULES>",
        "",
        "^@rax/(.*)$",
        "",
        "^@/lib/(.*)$",
        "^@/hooks/(.*)$",
        "^@/components/(.*)$",
        "",
        "^[.]",
        "",
        "\\.css$"
    ],
    "importOrderTypeScriptVersion": "5.0.0",
    "overrides": [
        {
            "files": ["*.json", "*.yaml", "*.yml", "*.md"],
            "options": { "tabWidth": 2 }
        }
    ]
}
